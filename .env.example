# Copier en .env (ignoré par git) puis renseigner.

# Suivi MLflow.
# - Vide ou absent : SQLite local (mlflow.db à la racine du projet).
# - Neon : URL DIRECTE (pas l'hôte "-pooler"), base dédiée "mlflow", SSL obligatoire.
#   URL copiée telle quelle depuis Neon (postgresql://) : pilote psycopg 3 (groupe Poetry ml).
# MLFLOW_TRACKING_URI=postgresql://<user>:<password>@<host>.neon.tech/mlflow?sslmode=require
MLFLOW_TRACKING_URI=

# Enregistrement des prédictions de l'API (base Neon dédiée "agritech_api", URL directe).
# Vide ou absent : enregistrement désactivé (cas de la CI et de docker compose).
# PREDICTION_DB_URL=postgresql://<user>:<password>@<host>.neon.tech/agritech_api?sslmode=require
PREDICTION_DB_URL=
