# Copier en .env (ignoré par git) puis renseigner.

# Suivi MLflow.
# - Vide ou absent : SQLite local (mlflow.db à la racine du projet).
# - Neon : URL DIRECTE (pas l'hôte "-pooler"), base dédiée "mlflow", SSL obligatoire.
# MLFLOW_TRACKING_URI=postgresql://<user>:<password>@<host>.neon.tech/mlflow?sslmode=require
MLFLOW_TRACKING_URI=
