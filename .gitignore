# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Secrets (URL Neon, tokens Docker Hub...)
.env

# Données brutes : jamais versionnées, seules les empreintes SHA256 le sont
data/raw/*
!data/raw/.gitkeep
!data/raw/SHA256SUMS
data/processed/*
!data/processed/.gitkeep
# Livrable de l'étape 1 (1,2 Mo) : source de vérité de l'entraînement, utilisé par la CI
!data/processed/crop_yield_consolidated.csv
# Intrants FAOSTAT raccordés (92 Ko) : expérience 03, sans les fichiers bruts
!data/processed/faostat_inputs.csv

# Sorties du pipeline (modèle candidat, jamais servi sans relecture)
artifacts/

# MLflow local
mlflow.db
mlflow.db-*
mlruns/
mlartifacts/

# Modèle servi par l'API : versionné (< 1 Mo) pour que l'image Docker se construise sans secret
models/*
!models/.gitkeep
!models/yield_model.joblib
!models/model_card.json
!models/practice_gains.json

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.vscode/
.idea/
Zone.Identifier
*:Zone.Identifier

# Captures d'écran avant recadrage (contiennent la barre du navigateur)
reports/_captures_originales/
